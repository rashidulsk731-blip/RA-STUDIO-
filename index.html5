<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RA STUDIO | Online Work Learning</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial, sans-serif;
}

body{
  background:#070707;
  color:#fff;
  line-height:1.6;
}

header{
  position:sticky;
  top:0;
  z-index:1000;
  background:rgba(5,5,5,.95);
  border-bottom:1px solid #292929;
  padding:15px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.logo{
  font-size:25px;
  font-weight:900;
  color:#d4af37;
  letter-spacing:2px;
}

nav a{
  color:#fff;
  text-decoration:none;
  margin-left:18px;
  font-size:14px;
}

nav a:hover{
  color:#d4af37;
}

.hero{
  min-height:90vh;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:70px 6%;
  background:
  radial-gradient(circle at top,#342b0c 0,#070707 45%);
}

.hero h1{
  font-size:clamp(42px,8vw,80px);
  color:#d4af37;
  margin-bottom:10px;
}

.hero h2{
  font-size:clamp(25px,5vw,45px);
  margin-bottom:20px;
}

.hero p{
  max-width:700px;
  margin:auto;
  color:#ccc;
}

.btn{
  display:inline-block;
  margin-top:25px;
  padding:14px 28px;
  border-radius:30px;
  background:#d4af37;
  color:#000;
  text-decoration:none;
  font-weight:bold;
  margin-right:8px;
}

.btn.dark{
  background:#171717;
  color:#fff;
  border:1px solid #d4af37;
}

section{
  padding:70px 6%;
}

.title{
  text-align:center;
  margin-bottom:45px;
}

.title h2{
  color:#d4af37;
  font-size:35px;
}

.title p{
  color:#aaa;
}

.features{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:20px;
}

.feature{
  background:#111;
  border:1px solid #292929;
  border-radius:18px;
  padding:25px;
  text-align:center;
  transition:.3s;
}

.feature:hover{
  transform:translateY(-6px);
  border-color:#d4af37;
}

.icon{
  font-size:38px;
  margin-bottom:10px;
}

.feature h3{
  color:#d4af37;
}

.packages{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:25px;
  max-width:1100px;
  margin:auto;
}

.card{
  background:linear-gradient(145deg,#151515,#090909);
  border:1px solid #333;
  border-radius:22px;
  padding:30px;
  text-align:center;
  position:relative;
  overflow:hidden;
}

.card.premium{
  border:2px solid #d4af37;
  transform:scale(1.03);
}

.badge{
  position:absolute;
  top:12px;
  right:-35px;
  background:#d4af37;
  color:#000;
  padding:5px 40px;
  transform:rotate(35deg);
  font-size:12px;
  font-weight:bold;
}

.price{
  font-size:42px;
  color:#d4af37;
  font-weight:bold;
  margin:15px 0;
}

.card ul{
  list-style:none;
  text-align:left;
  margin:20px 0;
}

.card li{
  padding:7px 0;
  color:#ddd;
}

.card li::before{
  content:"✓ ";
  color:#d4af37;
  font-weight:bold;
}

.lessons{
  max-width:850px;
  margin:auto;
}

.lesson{
  background:#111;
  border:1px solid #292929;
  border-radius:15px;
  padding:20px;
  margin:12px 0;
}

.lesson strong{
  color:#d4af37;
}

.payment{
  text-align:center;
  background:linear-gradient(135deg,#17130a,#080808);
}

.qr{
  width:230px;
  max-width:80%;
  background:#fff;
  padding:10px;
  border-radius:15px;
  margin:20px auto;
  display:block;
}

.contact-box{
  max-width:600px;
  margin:auto;
  text-align:center;
  background:#111;
  border:1px solid #333;
  border-radius:20px;
  padding:35px;
}

footer{
  text-align:center;
  padding:30px;
  background:#030303;
  border-top:1px solid #222;
  color:#999;
}

footer strong{
  color:#d4af37;
}

@media(max-width:700px){
  nav{
    display:none;
  }

  .card.premium{
    transform:none;
  }

  section{
    padding:55px 5%;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">RA STUDIO</div>

