.order-form{
  max-width:650px;
  margin:auto;
  background:linear-gradient(145deg,#151515,#080808);
  padding:35px;
  border-radius:25px;
  border:1px solid #d4af37;
  box-shadow:0 15px 50px rgba(0,0,0,.5);
}

.order-form label{
  display:block;
  margin-top:15px;
  margin-bottom:7px;
  color:#d4af37;
  font-weight:bold;
}

.order-form input,
.order-form select,
.order-form textarea{
  width:100%;
  padding:14px;
  border-radius:10px;
  border:1px solid #333;
  background:#0d0d0d;
  color:#fff;
  outline:none;
}

.order-form input:focus,
.order-form select:focus,
.order-form textarea:focus{
  border-color:#d4af37;
}

.order-form textarea{
  min-height:100px;
  resize:vertical;
}

.order-form button{
  width:100%;
  margin-top:25px;
  padding:15px;
  border:0;
  border-radius:30px;
  background:#d4af37;
  color:#000;
  font-size:16px;
  font-weight:bold;
  cursor:pointer;
}

.order-form button:hover{
  background:#fff;
}
